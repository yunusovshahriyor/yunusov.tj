[
 {
  "i": 0,
  "text": "Тағйирёбанда.",
  "start": 0.0,
  "end": 1.02,
  "snap": true
 },
 {
  "i": 1,
  "text": "Калимаи душвор менамояд, лекин аслан хеле оддӣ аст.",
  "start": 1.33,
  "end": 4.58,
  "snap": true
 },
 {
  "i": 2,
  "text": "Ҳозир дар як дақиқа мефаҳмем.",
  "start": 4.88,
  "end": 6.81,
  "snap": true
 },
 {
  "i": 3,
  "text": "Тасаввур кунед, ки як қуттӣ доред.",
  "start": 7.11,
  "end": 9.29,
  "snap": true
 },
 {
  "i": 4,
  "text": "Қуттии оддии картонӣ.",
  "start": 9.6,
  "end": 11.3,
  "snap": true
 },
 {
  "i": 5,
  "text": "Болои он ном менависем, масалан: «age», яъне синну сол.",
  "start": 11.6,
  "end": 15.55,
  "snap": true
 },
 {
  "i": 6,
  "text": "Ва дар дохили он рақам мегузорем: бисту панҷ.",
  "start": 15.83,
  "end": 18.85,
  "snap": true
 },
 {
  "i": 7,
  "text": "Дар барномасозӣ ин чунин навишта мешавад: let age = 25.",
  "start": 19.16,
  "end": 24.0,
  "snap": true
 },
 {
  "i": 8,
  "text": "Яъне қуттии «age» қимати бисту панҷ дорад.",
  "start": 24.31,
  "end": 27.53,
  "snap": true
 },
 {
  "i": 9,
  "text": "Як сол мегузарад.",
  "start": 27.83,
  "end": 28.84,
  "snap": true
 },
 {
  "i": 10,
  "text": "Рақами кӯҳнаро нест мекунем ва ба ҷои он бисту шашро мегузорем.",
  "start": 29.15,
  "end": 33.06,
  "snap": true
 },
 {
  "i": 11,
  "text": "Қуттӣ ҳамон, ном ҳамон.",
  "start": 33.37,
  "end": 34.41,
  "snap": true
 },
 {
  "i": 12,
  "text": "Танҳо қимат иваз шуд.",
  "start": 34.73,
  "end": 36.48,
  "snap": true
 },
 {
  "i": 13,
  "text": "Барои ҳамин онро «тағйирёбанда» мегӯянд: чизе, ки тағйир меёбад.",
  "start": 36.79,
  "end": 40.9,
  "snap": true
 },
 {
  "i": 14,
  "text": "Ин дар ҳаёт ҳам ҳаст, масалан:",
  "start": 41.21,
  "end": 43.53,
  "snap": true
 },
 {
  "i": 15,
  "text": "холи бозӣ, бақияи ҳисоби бонк, шумораи пайравонатон дар Instagram.",
  "start": 43.84,
  "end": 50.31,
  "snap": true
 },
 {
  "i": 16,
  "text": "Ҳамааш тағйирёбанда аст.",
  "start": 50.62,
  "end": 52.24,
  "snap": true
 },
 {
  "i": 17,
  "text": "Ном — болои қуттӣ.",
  "start": 52.49,
  "end": 53.95,
  "snap": true
 },
 {
  "i": 18,
  "text": "Қимат — дар дохили қуттӣ.",
  "start": 54.08,
  "end": 55.83,
  "snap": true
 },
 {
  "i": 19,
  "text": "Ва қимат тағйир меёбад.",
  "start": 55.96,
  "end": 57.52,
  "snap": true
 },
 {
  "i": 20,
  "text": "Ва акнун савол: агар қуттии худатонро медоштед, номаш чӣ мешуд ва дар дохилаш чӣ мегузоштед?",
  "start": 57.81,
  "end": 64.47,
  "snap": true
 },
 {
  "i": 21,
  "text": "Дар шарҳ нависед.",
  "start": 64.78,
  "end": 65.91,
  "snap": true
 },
 {
  "i": 22,
  "text": "Дарси оянда — шарт, «if/else».",
  "start": 66.23,
  "end": 67.65,
  "snap": true
 },
 {
  "i": 23,
  "text": "Обуна шавед!",
  "start": 67.95,
  "end": 69.62,
  "snap": true
 }
]