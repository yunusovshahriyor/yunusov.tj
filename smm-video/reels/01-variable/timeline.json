[
 {
  "i": 0,
  "text": "Тағйирёбанда?",
  "start": 0.0,
  "end": 1.02,
  "snap": true
 },
 {
  "i": 1,
  "text": "Калимаи душвор менамояд, лекин аслан хеле оддӣ аст.",
  "start": 1.31,
  "end": 4.59,
  "snap": true
 },
 {
  "i": 2,
  "text": "Ҳозир дар як дақиқа мефаҳмем.",
  "start": 4.82,
  "end": 6.41,
  "snap": true
 },
 {
  "i": 3,
  "text": "Тасаввур кунед, ки як қуттӣ доред.",
  "start": 6.89,
  "end": 8.57,
  "snap": true
 },
 {
  "i": 4,
  "text": "Қуттии оддии картонӣ.",
  "start": 8.89,
  "end": 10.47,
  "snap": true
 },
 {
  "i": 5,
  "text": "Болои он ном менависем, масалан: «age», яъне синну сол.",
  "start": 10.75,
  "end": 15.57,
  "snap": true
 },
 {
  "i": 6,
  "text": "Ва дар дохили он рақам мегузорем, масалан: 25.",
  "start": 16.0,
  "end": 19.73,
  "snap": true
 },
 {
  "i": 7,
  "text": "Дар барномасозӣ ин чунин навишта мешавад: let age = 25.",
  "start": 20.13,
  "end": 25.26,
  "snap": true
 },
 {
  "i": 8,
  "text": "Яъне қуттии «age» қимати 25-ро дорад.",
  "start": 25.62,
  "end": 28.82,
  "snap": true
 },
 {
  "i": 9,
  "text": "Як сол мегузарад.",
  "start": 29.22,
  "end": 30.26,
  "snap": true
 },
 {
  "i": 10,
  "text": "Рақами кӯҳнаро нест мекунем ва ба ҷои он 26-ро мегузорем.",
  "start": 30.53,
  "end": 34.7,
  "snap": true
 },
 {
  "i": 11,
  "text": "Қуттӣ ҳамон, ном ҳамон.",
  "start": 35.05,
  "end": 36.74,
  "snap": true
 },
 {
  "i": 12,
  "text": "Танҳо қимат иваз шуд.",
  "start": 37.07,
  "end": 38.58,
  "snap": true
 },
 {
  "i": 13,
  "text": "Барои ҳамин онро «тағйирёбанда» мегӯянд: чизе, ки тағйир меёбад.",
  "start": 39.05,
  "end": 43.15,
  "snap": true
 },
 {
  "i": 14,
  "text": "Дар ҳаёти ҳаррӯзи мо низ чунин тағйирёбандаҳо зиёданд, масалан:",
  "start": 43.58,
  "end": 47.79,
  "snap": true
 },
 {
  "i": 15,
  "text": "холи бозӣ, бақияи ҳисоби бонкӣ, шумораи пайравонатон дар Instagram.",
  "start": 48.1,
  "end": 53.28,
  "snap": true
 },
 {
  "i": 16,
  "text": "Ҳамааш тағйирёбанда мебошанд.",
  "start": 53.55,
  "end": 55.88,
  "snap": true
 },
 {
  "i": 17,
  "text": "Ном — болои қуттӣ.",
  "start": 56.34,
  "end": 58.01,
  "snap": true
 },
 {
  "i": 18,
  "text": "Қимат — дар дохили қуттӣ.",
  "start": 58.34,
  "end": 60.31,
  "snap": true
 },
 {
  "i": 19,
  "text": "Ва қимат тағйир меёбад.",
  "start": 60.64,
  "end": 62.77,
  "snap": true
 },
 {
  "i": 20,
  "text": "Агар қуттии худатонро медоштед, онро чӣ номгузорӣ мекардед?",
  "start": 63.24,
  "end": 66.73,
  "snap": true
 },
 {
  "i": 21,
  "text": "Дар дохили он чӣ мегузоштед?",
  "start": 66.98,
  "end": 68.59,
  "snap": true
 },
 {
  "i": 22,
  "text": "Дар шарҳ нависед.",
  "start": 68.88,
  "end": 69.9,
  "snap": true
 },
 {
  "i": 23,
  "text": "Дарси оянда — шарт, «if/else».",
  "start": 70.24,
  "end": 71.95,
  "snap": true
 },
 {
  "i": 24,
  "text": "Обуна шавед, то аз ҷаҳони барномасозӣ бехабар намонед!",
  "start": 72.27,
  "end": 77.11,
  "snap": true
 }
]